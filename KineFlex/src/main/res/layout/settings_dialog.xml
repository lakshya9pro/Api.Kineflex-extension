<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#141414"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kineflex_settings_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- KineFlex API Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F1F1F"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kineflex_api_key_label"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kineflexStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Not configured"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/kineflexKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2B2B2B"
                android:textColor="#FFFFFF"
                android:hint="Enter KineFlex API key (kine_live_...)"
                android:textColorHint="#666666"
                android:inputType="textPassword"
                android:padding="10dp" />

            <CheckBox
                android:id="@+id/kineflexShowKeyCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_key"
                android:textColor="#BBBBBB" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/kineflexTestBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_connection" />

                <Button
                    android:id="@+id/kineflexClearBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/clear_key" />
            </LinearLayout>
        </LinearLayout>

        <!-- TMDB Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F1F1F"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_api_key_label"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tmdbStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Not configured"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/tmdbKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2B2B2B"
                android:textColor="#FFFFFF"
                android:hint="Enter TMDB v3 API Key or v4 Access Token"
                android:textColorHint="#666666"
                android:inputType="textPassword"
                android:padding="10dp" />

            <CheckBox
                android:id="@+id/tmdbShowKeyCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_key"
                android:textColor="#BBBBBB" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/tmdbTestBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_connection" />

                <Button
                    android:id="@+id/tmdbClearBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/clear_key" />
            </LinearLayout>
        </LinearLayout>

        <!-- Save / Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel_settings" />

            <Button
                android:id="@+id/saveSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/save_settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
